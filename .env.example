# Copy these into Dokploy → your Compose service → Environment.
# Generate secrets with scripts/generate-secrets.sh (or the PowerShell version).

# Two host names: the portal, and phpMyAdmin on its own host (keeps them isolated in the browser).
PORTAL_DOMAIN=db.example.com
PMA_DOMAIN=pma.db.example.com

# Sign-in with Bikiran (OpenID Connect). Register this redirect URI with the provider:
#   https://<PORTAL_DOMAIN>/auth/callback
OIDC_PROVIDER_NAME=Bikiran
OIDC_ISSUER=https://accounts.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional:
# OIDC_SCOPES=openid email profile
# OIDC_TOKEN_AUTH=basic            # or "post"
# OIDC_USER_ID_CLAIM=sub           # the permanent user ID
# OIDC_REQUIRED_AMR=mfa            # require 2-step verification, if the provider reports it in "amr"
# OIDC_REQUIRE_EMAIL_VERIFIED=true

# Secrets (each different, random). Back up VAULT_KEY somewhere safe: without it, saved
# database passwords cannot be decrypted.
VAULT_KEY=
GATEWAY_TOKEN=
PMA_TOKEN=

# Platform admins: user IDs (the OIDC "sub" claim), comma-separated.
ADMIN_SUBJECTS=

# Optional
# PORTAL_NAME=DB Portal
# EGRESS_IP=203.0.113.10           # this server's public IP (recommended): shown for firewall rules; phpMyAdmin never connects to it
# CLOUDFLARE_ONLY=true             # accept traffic only from Cloudflare (see README)
# EGRESS_BLOCK_CIDRS=198.51.100.0/24  # extra addresses phpMyAdmin must never reach
# EGRESS_ALLOW_CIDRS=              # private ranges phpMyAdmin may reach as "remote" (leave empty)
# PMA_DATABASES_NETWORK=pma-databases
# CERT_RESOLVER=letsencrypt
