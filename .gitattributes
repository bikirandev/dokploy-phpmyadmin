# Auto detect text files and perform LF normalization
* text=auto

# Files used inside Linux containers must keep LF line endings, even on Windows checkouts.
*.sh text eol=lf
*.php text eol=lf
*.conf text eol=lf
*.cnf text eol=lf
*.inc text eol=lf
*.ini text eol=lf
*.template text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.py text eol=lf
Dockerfile text eol=lf
sshd_config text eol=lf
cloudflare-ips.txt text eol=lf
